# Copy to .env and change the values.

POSTGRES_PASSWORD=12345678

# Where the code is: a checkout next to this file (git clone) or any path.
GPXTILER_SRC=./gpxtiler
GPX_VECTOR_TILES_SRC=./gpx-vector-tiles

# Setup here: load the 2013 dump from a local file, then follow the new
# traces of openstreetmap.org.

# GPX dump for the first import: a file in ./data (as /data/...) or a URL.
# The default is the file that convert-2013 makes.
GPXTILER_DUMP=/data/gpx-planet-2013.gpx.bz2

# Website for update -rss and for downloading traces: the openstreetmap
# website (with /traces/rss), not the planet server with the dumps.
GPXTILER_SITE=https://www.openstreetmap.org

# Where update -rss starts the first time. Empty: after the highest id in
# the database. "latest": at the newest trace in the RSS feed, so only the
# traces uploaded from now on are loaded. Use "latest" with the 2013 dump:
# the ids in between are millions, they come from the id list instead.
GPXTILER_RSS_START_ID=latest

# convert-2013: the 2013 dump (URL, or a file in ./data as /data/...).
GPX_2013_SRC=https://planet.openstreetmap.org/gps/gpx-planet-2013-04-09.tar.xz

# Daily list of identifiable trace ids for update -ids (profile "ids").
# GPXTILER_IDS=https://planet-gpx-tracks.rub21.com/gpx_ids/identifiable.txt

# Ports on the host.
GPXTILER_PORT=8080
TILEKILN_PORT=8081
VIEWER_PORT=8090

# Seconds between update runs.
GPXTILER_RSS_EVERY=300
GPXTILER_IDS_EVERY=86400

# Zooms written to the expire files (one z/x/y line per zoom and tile).
GPXTILER_EXPIRE_MIN_ZOOM=0
GPXTILER_EXPIRE_MAX_ZOOM=14

# Colors per PNG tile, like pngquant on the current tiles. 0 = full color.
GPXTILER_COLORS=64

# Zooms with a simplified copy of the lines, for the low zoom tiles.
# Changing it needs a new import.
GPXTILER_SIMPLIFIED_ZOOMS=5,8,11

# PNG tiles on disk. serve keeps the tiles it draws up to CACHE_ZOOM; above
# that it draws on every request.
GPXTILER_CACHE_ZOOM=14

# render-all: zooms drawn in advance, once, before opening the server.
GPXTILER_PRERENDER_ZOOMS=0-9

# render-expired: every RENDER_EXPIRED_EVERY seconds, redraw the expired
# tiles of EXPIRED_ZOOMS and remove the expired ones above from disk.
GPXTILER_EXPIRED_ZOOMS=6-9
GPXTILER_RENDER_EXPIRED_EVERY=300

# render-daily: every RENDER_DAILY_EVERY seconds, redraw all the tiles of
# DAILY_ZOOMS (the ones render-expired does not touch).
GPXTILER_DAILY_ZOOMS=0-5
GPXTILER_RENDER_DAILY_EVERY=86400
