# Copy to .env and change the values. The sections follow the order of use.

######### Database (PostGIS)
# Memory for Postgres (see the db service in compose.yaml). For 8 GB of
# RAM: 2GB and 5GB. Use about 1/4 and 2/3 of the RAM.
# PG_SHARED_BUFFERS=2GB
# PG_EFFECTIVE_CACHE_SIZE=5GB
POSTGRES_PASSWORD=change-me

######### Code
# Where gpxtiler and gpx-vector-tiles are: a checkout next to this file
# (git clone) or any path.
GPXTILER_SRC=./gpxtiler
GPX_VECTOR_TILES_SRC=./gpx-vector-tiles

######### convert-2013: docker compose run --rm convert-2013
# The 2013 dump (URL, or a file in ./data as /data/...). The service turns
# it into data/gpx-planet-2013.gpx.bz2, the format gpxtiler reads.
GPX_2013_SRC=https://planet.openstreetmap.org/gps/gpx-planet-2013-04-09.tar.xz

######### import: docker compose run --rm import
# GPX dump to load: a file in ./data (as /data/...) or a URL. Default: the
# file that convert-2013 makes.
GPXTILER_DUMP=/data/gpx-planet-2013.gpx.bz2
# Zooms with a simplified copy of the lines, for the low zoom tiles.
# Changing it needs a new import.
GPXTILER_SIMPLIFIED_ZOOMS=5,8,11

######### update-rss and update-ids
# Website with the RSS feed and the traces: the openstreetmap website
# (with /traces/rss), not the planet server with the dumps.
GPXTILER_SITE=https://www.openstreetmap.org
# Where update-rss starts the first time. Empty: after the highest id in
# the database. "latest": at the newest trace in the RSS feed, so only the
# traces uploaded from now on are loaded. Use "latest" with the 2013 dump:
# the ids in between are millions, they come from the id list instead.
GPXTILER_RSS_START_ID=latest
# Daily list of identifiable trace ids for update-ids (profile "ids").
# GPXTILER_IDS=https://planet.openstreetmap.org/gps/gpx_ids/identifiable.txt
# Seconds between runs.
GPXTILER_RSS_EVERY=300
GPXTILER_IDS_EVERY=86400
# Zooms written to the expire files (one z/x/y line per zoom and tile).
# EXPIRE_MAX_ZOOM and CACHE_ZOOM must be the same.
GPXTILER_EXPIRE_MIN_ZOOM=0
GPXTILER_EXPIRE_MAX_ZOOM=14

######### serve (PNG tiles)
# serve keeps the tiles it draws on disk up to CACHE_ZOOM; above that it
# draws on every request.
GPXTILER_CACHE_ZOOM=14
# Colors per PNG tile, like pngquant on the current tiles. 0 = full color.
GPXTILER_COLORS=64

######### render-all: docker compose run --rm render-all
# Zooms drawn in advance, once, before opening the server.
GPXTILER_PRERENDER_ZOOMS=0-9

######### render-expired
# Every RENDER_EXPIRED_EVERY seconds, redraw the expired tiles of
# EXPIRED_ZOOMS and remove the expired ones above from disk.
GPXTILER_EXPIRED_ZOOMS=6-9
GPXTILER_RENDER_EXPIRED_EVERY=300

######### render-daily
# Every RENDER_DAILY_EVERY seconds, redraw all the tiles of DAILY_ZOOMS
# (the ones render-expired does not touch).
GPXTILER_DAILY_ZOOMS=0-5
GPXTILER_RENDER_DAILY_EVERY=86400

######### Tilekiln (vector tiles), stored in the database like on vector.openstreetmap.org
# Worker processes of Tilekiln (serve and generate).
TILEKILN_THREADS=2
# tilekiln-zooms: zooms drawn in advance, once (docker compose run --rm tilekiln-zooms).
TILEKILN_PRERENDER_ZOOMS_MIN=0
TILEKILN_PRERENDER_ZOOMS_MAX=9
# tilekiln-expired (every RENDER_EXPIRED_EVERY seconds): expired tiles of
# these zooms are drawn again, the expired ones above are deleted.
TILEKILN_EXPIRED_ZOOMS_MIN=6
TILEKILN_EXPIRED_ZOOMS_MAX=9
# tilekiln-daily (every RENDER_DAILY_EVERY seconds): all these zooms again.
TILEKILN_DAILY_ZOOMS_MIN=0
TILEKILN_DAILY_ZOOMS_MAX=5

## Ports on the host (serve, tilekiln, viewer)
GPXTILER_PORT=8080
TILEKILN_PORT=8081
VIEWER_PORT=8090

######### Traefik (HTTPS): docker compose --profile web up -d
# The domain, the public URL (for the TileJSON) and the email for Let's
# Encrypt.
GPX_TILES_HOST=gpx-tiles.rub21.com
GPX_TILES_URL=https://gpx-tiles.rub21.com
ACME_EMAIL=rub2106@gmail.com
DOCKER_SOCK=/var/run/docker.sock
